{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "#api/*": ["./packages/api-client/src/*"],
      "#auth/*": ["./packages/auth/src/*"],
      "#i18n/*": ["./packages/i18n/src/*"],
      "#shell/*": ["./packages/shell/src/*"],
      "#ui/*": ["./packages/ui/src/*"],
      "@steward-web/dev-gate-preview.server": [
        "./packages/auth/src/NoDevelopmentGatePreview.server.ts"
      ],
      "@steward-web/dev-quick-login": ["./packages/auth/src/NoQuickLogin.tsx"],
      "@steward-web/dev-quick-login.server": [
        "./packages/auth/src/NoDevelopmentQuickLogin.server.ts"
      ],
      "@steward-web/dev-ui-issue-button": ["./packages/shell/src/NoDevelopmentUiIssueButton.tsx"],
      "@steward-web/edge.server": ["./packages/api-client/src/edge/live.server.ts"]
    }
  },
  "files": ["./types/env.d.ts"]
}
