# Pins for packages/api-client/scripts/schema-generate.sh and schema-check.sh.
#
# STEWARD_GATEWAY_REF is a full commit sha on steward-gateway's main branch.
# schema-generate.sh fetches graphql/*.graphqls at that commit, assembles them into
# schema/gateway.graphql and writes the file's SHA-256 below. schema-check.sh (run by
# `pnpm run check`) verifies, offline, that the committed file names this commit and
# matches the hash, and that src/generated/ is what codegen makes from it.
STEWARD_GATEWAY_REF=8755829ec178cc052895fe01f4575d11b308c04b
STEWARD_GATEWAY_SCHEMA_SHA256=105be42b3b0810a83c243cb5445167c640f44deb15ba10857867ba7f263f5e5a
