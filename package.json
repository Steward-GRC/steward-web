{
  "name": "steward-web",
  "version": "0.0.0",
  "description": "Web apps for Steward: the staff and admin apps, the docs guide and the UI kit",
  "author": "The Steward Authors",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steward-GRC/steward-web.git"
  },
  "homepage": "https://github.com/Steward-GRC/steward-web#readme",
  "bugs": {
    "url": "https://github.com/Steward-GRC/steward-web/issues"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:mock": "pnpm -r --if-present run build:mock",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r --if-present run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:no-mock-leak": "node scripts/check-no-mock-leak.mjs",
    "check:schema": "bash packages/api-client/scripts/schema-check.sh",
    "check": "pnpm run check:schema && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:no-mock-leak"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@the-rabbit-hole/eslint-config": "^0.7.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
