{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // vite.config.ts reaches server/src/assetProxy.ts (real .ts imports, run by Node).
    "allowImportingTsExtensions": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest",
      "@react-router/node"
    ]
  },
  "include": ["app", "react-router.config.ts", "vite.config.ts", ".react-router/types/**/*"]
}
